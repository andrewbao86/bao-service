# Public site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://baoservice.net

# Optional: Google Apps Script web app URL — forwards modal leads and hiring pitches to Google Sheets
# Deploy script from docs/google-apps-script/leads-webhook.gs; override in Amplify env vars for production
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwxxaXzftDSHy-JtrdakHoDwWc6v8MiGM3PgLAiyXP1vvfoDLpK0654MMLIxB0t09JzhA/exec

# Optional: Google Apps Script GET feed for hiring hero bullet updates (separate spreadsheet)
# Deploy script from docs/google-apps-script/hiring-updates-feed.gs
HIRING_UPDATES_URL=https://script.google.com/macros/s/AKfycbyhUbC0jdNOmUreovy-0lRX98aQd8J3A6-cKPmDub9GwqPaAWQJGKECEsZpD9XnDrT4/exec
# Optional: Cloudflare Turnstile for /api/hiring spam protection (leave unset to use honeypot + rate limit only)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: include webhook diagnostics in /api/leads and /api/hiring JSON responses (Amplify debugging)
# WEBHOOK_DEBUG=true

# Optional Firebase Analytics (set in Amplify environment variables)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bao-service.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bao-service
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bao-service.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=897329851343
NEXT_PUBLIC_FIREBASE_APP_ID=1:897329851343:web:3479d601849359669640ba
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-T4R96KFP86

WEBHOOK_DEBUG=true